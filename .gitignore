# ==============================================================================
# ZZZ-Bot Git Ignore Rules (.gitignore)
# ==============================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Sensitive credentials & runtime tokens
config/Telegram.yaml
config/QQBot.yaml
*.key
*.pem
*.token

# Runtime data & container volumes
data/yunzai/
data/cache/
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
temp/
tmp/

# Dependency directories
node_modules/
.pnpm-store/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# Internal debug reports & audit archives (keep docx tracked for project requirements)
!docx/
!docx/**
