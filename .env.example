# ==============================================================================
# ZZZ-Bot 容器化部署环境变量配置文件模板 (.env.example)
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env (Linux/WSL) 或 Copy-Item .env.example .env (PowerShell)
# 2. 根据实际部署环境配置相应路径与参数
# ==============================================================================

# 容器时区设置
TZ=Asia/Shanghai

# 容器内运行用户与用户组 UID/GID
PUID=1000
PGID=1000

# 数据持久化目录（TRSS-Yunzai 运行目录挂载路径）
# 选项 A（WSL 生产环境推荐）: /home/bjrst/docker/data/zzz-bot/yunzai
# 选项 B（当前仓库相对路径）: ./data/yunzai
DATA_ROOT=/home/bjrst/docker/data/zzz-bot/yunzai

# 容器构建与编排配置目录（供桌面 Compose 脚本 zzz.yml 使用）
CONFIG_ROOT=/home/bjrst/docker/config/zzz-bot

# 宿主机 Web 状态端口与绑定地址（安全基线：默认仅绑定本地 127.0.0.1）
BIND_IP=127.0.0.1
PORT=16677
